---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return posts.map(post => ({
    params: { slug: post.slug },
    props:  { post },
  }));
}

const { post } = Astro.props;
const { data }  = post;
const { Content } = await post.render();

function fmtDate(d: Date): string {
  return d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
}
---

<Base
  title={`${data.title} — Jason Soo`}
  description={data.excerpt}
  showProgress={false}
  showCanvas={false}
>
  <div class="post-page">

    <a href={`${base}#work`} class="post-back">← Back to work</a>

    {data.coverImage && (
      <div class="post-cover-wrap">
        <Image
          src={data.coverImage}
          alt={data.coverCaption ?? data.title}
          class="post-cover"
          widths={[800, 1200, 1600]}
          sizes="(max-width: 800px) 100vw, 72ch"
        />
        {data.coverCaption && (
          <span class="post-cover-caption">{data.coverCaption}</span>
        )}
      </div>
    )}

    <div class="post-meta">
      <span class="post-meta-kind">{data.kind}</span>
      <span class="post-meta-date">{data.displayDate ?? fmtDate(data.date)}</span>
      <div class="post-meta-tags">
        {data.tags.map(t => <span class="post-meta-tag">{t}</span>)}
      </div>
    </div>

    <h1 class="post-title">{data.title}</h1>

    <div class="prose">
      <Content />
    </div>

    {(data.githubUrl || data.external) && (
      <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--rule-strong); display: flex; gap: 1.5rem;">
        {data.githubUrl && (
          <a
            href={data.githubUrl}
            target="_blank"
            rel="noopener"
            style="font-family:var(--mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:var(--ink-soft); transition:color 180ms; display:flex; align-items:center; gap:.4rem;"
          >↗ GitHub</a>
        )}
        {data.external && (
          <a
            href={data.external}
            target="_blank"
            rel="noopener"
            style="font-family:var(--mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:var(--ink-soft); transition:color 180ms; display:flex; align-items:center; gap:.4rem;"
          >↗ External link</a>
        )}
      </div>
    )}

  </div>
</Base>
